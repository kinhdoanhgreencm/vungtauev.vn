# Cấu hình gửi email khi khách hàng điền form trên website
# Copy file này thành .env.local rồi điền thông tin thật (không commit .env.local lên git)

# Với Gmail: dùng "Mật khẩu ứng dụng" (App Password), không dùng mật khẩu đăng nhập thường
# Tạo tại: https://myaccount.google.com/apppasswords (yêu cầu bật Xác minh 2 bước)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=htxvungtauev@gmail.com
SMTP_PASS=

# Email nhận thông tin khách hàng (mặc định trùng SMTP_USER nếu bỏ trống)
CONTACT_TO_EMAIL=htxvungtauev@gmail.com
